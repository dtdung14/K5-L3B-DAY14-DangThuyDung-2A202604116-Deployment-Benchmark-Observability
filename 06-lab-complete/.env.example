# ============================================================
# Biến môi trường của agent (tiêu chí 9). KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0

# Bảo mật — bắt buộc khi ENVIRONMENT=production. Tạo key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis — chạy local: redis://localhost:6379/0 ; trong compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
